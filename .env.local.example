NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Visitor beacon and crawler alerts -> Telegram. With either of these unset,
# both are a no-op.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to 1 to run both in development. Leave unset and localhost stays silent —
# which matters, because curl and python-requests are recognised crawler agents.
NEXT_PUBLIC_BEACON_DEBUG=

# Search engine ownership verification. Public identifiers, not secrets; each
# meta tag is omitted entirely when its variable is unset. Paste only the token
# from the provider's meta tag, not the whole tag.
#   Google : Search Console -> Settings -> Ownership verification -> HTML tag
#   Bing   : Webmaster Tools -> Site settings -> Verification -> Meta tag
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
