NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Enable after Google OAuth configuration and callback testing.
NEXT_PUBLIC_IMPRINT_GOOGLE_OAUTH_ENABLED=false

# Server-only global switch for assessment scoring and new Mirror sessions.
IMPRINT_AI_ENABLED=false
GEMINI_API_KEY=
GROQ_API_KEY=

# Server-only comma-separated IDs from lib/assessment/catalog.ts, e.g. illustrator.
IMPRINT_PILOT_ROLES=
# Software Developer checks use Vercel's project identity on Vercel.
# Optional override for local QA with the isolated Docker runner.
IMPRINT_RUNNER_ORIGIN=
IMPRINT_RUNNER_TOKEN=
# UUIDs allowed to process requested score and provenance reviews.
IMPRINT_REVIEWER_IDS=
# Optional tested model versions. Scoped separately to preserve score provenance.
IMPRINT_GEMINI_ASSESSMENT_MODEL=
IMPRINT_GEMINI_MIRROR_MODEL=
IMPRINT_GEMINI_TRANSCRIPTION_MODEL=
IMPRINT_GROQ_ASSESSMENT_MODEL=
IMPRINT_GROQ_VISION_MODEL=
IMPRINT_GROQ_MIRROR_MODEL=
IMPRINT_GROQ_SAFETY_MODEL=
IMPRINT_GROQ_TRANSCRIPTION_MODEL=
# Configure only when setting up opted-in task email delivery.
IMPRINT_CRON_SECRET=
RESEND_API_KEY=
IMPRINT_REMINDER_FROM=

# Visitor beacon and crawler alerts -> Telegram. With either of these unset,
# both are a no-op.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to 1 to run both in development. Leave unset and localhost stays silent —
# which matters, because curl and python-requests are recognised crawler agents.
NEXT_PUBLIC_BEACON_DEBUG=

# Search engine ownership verification. Public identifiers, not secrets; each
# meta tag is omitted entirely when its variable is unset. Paste only the token
# from the provider's meta tag, not the whole tag.
#   Google : Search Console -> Settings -> Ownership verification -> HTML tag
#   Bing   : Webmaster Tools -> Site settings -> Verification -> Meta tag
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
